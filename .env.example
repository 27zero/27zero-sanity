# ─────────────────────────────────────────────────────────────────────────────
# Pillarbase → Sanity Integration — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# ── Pillarbase ────────────────────────────────────────────────────────────────

# Base URL of the Pillarbase API (no trailing slash)
PILLARBASE_API_URL=

# API key issued by Pillarbase (Settings → API Keys in the Pillarbase dashboard)
PILLARBASE_API_KEY=

# ── Pillarbase — Studio tool (browser-exposed) ────────────────────────────────
# Sanity Studio only exposes variables prefixed with SANITY_STUDIO_ to the
# browser bundle.  These mirror the values above for use in the Studio tool.

SANITY_STUDIO_PILLARBASE_API_URL=
SANITY_STUDIO_PILLARBASE_API_KEY=

# ── Sanity ────────────────────────────────────────────────────────────────────

# Your Sanity project ID (visible in sanity.config.ts and manage.sanity.io)
SANITY_PROJECT_ID=u9sntfl9

# Dataset name (usually 'production')
SANITY_DATASET=production

# API token with Editor (or higher) permissions
# Create one at: https://www.sanity.io/manage → your project → API → Tokens
SANITY_API_TOKEN=
